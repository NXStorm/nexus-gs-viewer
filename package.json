{
  "name": "nexus-gs-viewer",
  "productName": "NEXUS GS Viewer",
  "version": "0.13.3",
  "description": "NEXUS GS Viewer — Gaussian Splatting viewer and editor: playblasts, Nuke camera round-trip, cleanup tools",
  "main": "./out/main/index.js",
  "author": "innoprodigious",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --win",
    "package": "electron-vite build && node scripts/package.mjs"
  },
  "dependencies": {
    "@sparkjsdev/spark": "^2.1.0",
    "mp4-muxer": "^5.2.2",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.2.1",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "com.innoprodigious.nexgsviewer",
    "productName": "NEXUS GS Viewer",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
